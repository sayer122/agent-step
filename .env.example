# Required for agentic and live test projects.
# Use the OpenAI-compatible *root*, not /chat/completions.
# OpenAI:
# AGENT_LLM_BASE_URL=https://api.openai.com/v1
# AGENT_LLM_MODEL=gpt-4o-mini
# OpenRouter:
AGENT_LLM_BASE_URL=https://openrouter.ai/api/v1
AGENT_LLM_API_KEY=your-api-key
AGENT_LLM_MODEL=openai/gpt-4o-mini

# Optional: base URL when testing against a deployed app
AGENT_BASE_URL=http://127.0.0.1:4173
